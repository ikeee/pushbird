{
  "name": "pushbird",
  "version": "0.0.2",
  "releaseVersion": "0.02",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-models.mjs && node scripts/copy-vision-runtime.mjs",
    "predev": "npm run setup",
    "prebuild": "npm run setup",
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/main.js && npm test && npm run build",
    "release:check": "node scripts/public-release-check.mjs"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "esbuild": "0.21.5",
    "playwright": "1.64.1",
    "vite": "5.4.10"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32"
  }
}
